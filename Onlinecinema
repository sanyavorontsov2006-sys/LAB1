    )
    cinema.payments[1] = Payment(
        1, 1, 599.0, "Банковская карта", datetime.now().isoformat()
    )

    return cinema


def main() -> None:
    cinema = create_demo_cinema()

    try:
        cinema.save_json("cinema.json")
        cinema.save_xml("cinema.xml")

        loaded = OnlineCinema()
        loaded.load_json("cinema.json")

        print("Онлайн-кинотеатр успешно запущен.")
        print("Фильмы:", [movie.title for movie in loaded.catalog.movies.values()])
        print("Результат поиска:", [movie.title for movie in loaded.catalog.search("интер")])

  
        try:
            loaded.catalog.get(999)
        except NotFoundError as error:
            print("Обработанная ошибка:", error)

    except CinemaError as error:
        print("Ошибка приложения:", error)
    except OSError as error:
        print("Ошибка работы с файлом:", error)


if __name__ == "__main__":
    main()

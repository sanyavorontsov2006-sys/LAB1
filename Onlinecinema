from __future__ import annotations

import json
import xml.etree.ElementTree as ET
from dataclasses import dataclass, field
from datetime import datetime
from typing import Optional


class CinemaError(Exception):
    """Base exception for the online cinema application."""


class ValidationError(CinemaError):
    """Raised when input data is invalid."""


class NotFoundError(CinemaError):
    """Raised when an object cannot be found."""


class DuplicateError(CinemaError):
    """Raised when an object with the same identifier already exists."""


@dataclass
class Genre:
    genre_id: int
    name: str

    def __post_init__(self) -> None:
        if self.genre_id <= 0 or not self.name.strip():
            raise ValidationError("Некорректные данные жанра.")


@dataclass
class Director:
    director_id: int
    name: str

    def __post_init__(self) -> None:
        if self.director_id <= 0 or not self.name.strip():
            raise ValidationError("Некорректные данные режиссера.")


@dataclass
class Actor:
    actor_id: int
    name: str
    role: str

    def __post_init__(self) -> None:
        if self.actor_id <= 0 or not self.name.strip() or not self.role.strip():
            raise ValidationError("Некорректные данные актера.")


@dataclass
class Movie:
    movie_id: int
    title: str
    year: int
    duration: int
    age_rating: str
    director_id: int
    genre_ids: list[int] = field(default_factory=list)
    actor_ids: list[int] = field(default_factory=list)
    description: str = ""

    def __post_init__(self) -> None:
        if self.movie_id <= 0 or not self.title.strip():
            raise ValidationError("Название и ID фильма обязательны.")
        if not 1888 <= self.year <= datetime.now().year + 1:
            raise ValidationError("Некорректный год фильма.")
        if self.duration <= 0:
            raise ValidationError("Продолжительность должна быть положительной.")


@dataclass
class Subscription:
    subscription_id: int
    name: str
    price: float
    duration_days: int

    def __post_init__(self) -> None:
        if self.subscription_id <= 0 or not self.name.strip():
            raise ValidationError("Некорректные данные подписки.")
        if self.price < 0 or self.duration_days <= 0:
            raise ValidationError("Некорректная цена или длительность подписки.")


@dataclass
class Payment:
    payment_id: int
    user_id: int
    amount: float
    method: str
    created_at: str

    def __post_init__(self) -> None:
        if self.payment_id <= 0 or self.user_id <= 0 or self.amount <= 0:
            raise ValidationError("Некорректные данные платежа.")


@dataclass
class User:
    user_id: int
    name: str
    email: str
    password: str
    subscription_id: Optional[int] = None

    def __post_init__(self) -> None:
        if self.user_id <= 0 or not self.name.strip():
            raise ValidationError("Некорректные данные пользователя.")
        if "@" not in self.email:
            raise ValidationError("Некорректный email.")

    def change_subscription(self, subscription_id: int) -> None:
        self.subscription_id = subscription_id


@dataclass
class Profile:
    profile_id: int
    user_id: int
    nickname: str
    favorite_genres: list[int] = field(default_factory=list)

    def __post_init__(self) -> None:
        if self.profile_id <= 0 or self.user_id <= 0 or not self.nickname.strip():
            raise ValidationError("Некорректные данные профиля.")


@dataclass
class Review:
    review_id: int
    user_id: int
    movie_id: int
    rating: int
    text: str
    created_at: str

    def __post_init__(self) -> None:
        if not 1 <= self.rating <= 10:
            raise ValidationError("Оценка должна быть от 1 до 10.")


@dataclass
class WatchHistory:
    history_id: int
    user_id: int
    movie_id: int
    watched_at: str
    progress_percent: int

    def __post_init__(self) -> None:
        if not 0 <= self.progress_percent <= 100:
            raise ValidationError("Прогресс должен быть от 0 до 100.")


@dataclass
class Favorite:
    favorite_id: int
    user_id: int
    movie_id: int
    added_at: str


class MovieCatalog:

    def __init__(self) -> None:
        self.movies: dict[int, Movie] = {}

    def add(self, movie: Movie) -> None:
        if movie.movie_id in self.movies:
            raise DuplicateError("Фильм с таким ID уже существует.")
        self.movies[movie.movie_id] = movie

    def get(self, movie_id: int) -> Movie:
        try:
            return self.movies[movie_id]
        except KeyError as exc:
            raise NotFoundError("Фильм не найден.") from exc

    def update(self, movie: Movie) -> None:
        self.get(movie.movie_id)
        self.movies[movie.movie_id] = movie

    def delete(self, movie_id: int) -> None:
        self.get(movie_id)
        del self.movies[movie_id]

    def search(self, text: str) -> list[Movie]:
        text = text.lower()
        return [m for m in self.movies.values() if text in m.title.lower()]


class OnlineCinema:

    def __init__(self) -> None:
        self.users: dict[int, User] = {}
        self.profiles: dict[int, Profile] = {}
        self.genres: dict[int, Genre] = {}
        self.directors: dict[int, Director] = {}
        self.actors: dict[int, Actor] = {}
        self.catalog = MovieCatalog()
        self.subscriptions: dict[int, Subscription] = {}
        self.payments: dict[int, Payment] = {}
        self.reviews: dict[int, Review] = {}
        self.history: dict[int, WatchHistory] = {}
        self.favorites: dict[int, Favorite] = {}

    def add_user(self, user: User) -> None:
        if user.user_id in self.users:
            raise DuplicateError("Пользователь уже существует.")
        self.users[user.user_id] = user

    def add_genre(self, genre: Genre) -> None:
        if genre.genre_id in self.genres:
            raise DuplicateError("Жанр уже существует.")
        self.genres[genre.genre_id] = genre

    def add_subscription(self, subscription: Subscription) -> None:
        if subscription.subscription_id in self.subscriptions:
            raise DuplicateError("Подписка уже существует.")
        self.subscriptions[subscription.subscription_id] = subscription

    def add_review(self, review: Review) -> None:
        if review.review_id in self.reviews:
            raise DuplicateError("Отзыв уже существует.")
        if review.user_id not in self.users:
            raise NotFoundError("Пользователь для отзыва не найден.")
        self.reviews[review.review_id] = review

    def to_dict(self) -> dict:
        def convert(items):
            return [vars(item) for item in items.values()]

        return {
            "users": convert(self.users),
            "profiles": convert(self.profiles),
            "genres": convert(self.genres),
            "directors": convert(self.directors),
            "actors": convert(self.actors),
            "movies": convert(self.catalog.movies),
            "subscriptions": convert(self.subscriptions),
            "payments": convert(self.payments),
            "reviews": convert(self.reviews),
            "history": convert(self.history),
            "favorites": convert(self.favorites),
        }

    def save_json(self, filename: str) -> None:
        with open(filename, "w", encoding="utf-8") as file:
            json.dump(self.to_dict(), file, ensure_ascii=False, indent=4)

    def load_json(self, filename: str) -> None:
        try:
            with open(filename, "r", encoding="utf-8") as file:
                data = json.load(file)
            self._load_dict(data)
        except (OSError, json.JSONDecodeError) as exc:
            raise CinemaError(f"Ошибка чтения JSON: {exc}") from exc

    def save_xml(self, filename: str) -> None:
        root = ET.Element("online_cinema")
        data = self.to_dict()

        for collection_name, items in data.items():
            collection = ET.SubElement(root, collection_name)
            for item in items:
                element = ET.SubElement(collection, "item")
                for key, value in item.items():
                    child = ET.SubElement(element, key)
                    child.text = json.dumps(value, ensure_ascii=False)

        ET.ElementTree(root).write(filename, encoding="utf-8", xml_declaration=True)

    def load_xml(self, filename: str) -> None:
        try:
            root = ET.parse(filename).getroot()
            data = {}
            for collection in root:
                data[collection.tag] = []
                for item in collection:
                    obj = {}
                    for child in item:
                        obj[child.tag] = json.loads(child.text or 'null')
                    data[collection.tag].append(obj)
            self._load_dict(data)
        except (OSError, ET.ParseError, json.JSONDecodeError) as exc:
            raise CinemaError(f"Ошибка чтения XML: {exc}") from exc

    def _load_dict(self, data: dict) -> None:
        self.users = {x["user_id"]: User(**x) for x in data.get("users", [])}
        self.profiles = {x["profile_id"]: Profile(**x) for x in data.get("profiles", [])}
        self.genres = {x["genre_id"]: Genre(**x) for x in data.get("genres", [])}
        self.directors = {x["director_id"]: Director(**x) for x in data.get("directors", [])}
        self.actors = {x["actor_id"]: Actor(**x) for x in data.get("actors", [])}
        self.catalog.movies = {x["movie_id"]: Movie(**x) for x in data.get("movies", [])}
        self.subscriptions = {
            x["subscription_id"]: Subscription(**x)
            for x in data.get("subscriptions", [])
        }
        self.payments = {x["payment_id"]: Payment(**x) for x in data.get("payments", [])}
        self.reviews = {x["review_id"]: Review(**x) for x in data.get("reviews", [])}
        self.history = {x["history_id"]: WatchHistory(**x) for x in data.get("history", [])}
        self.favorites = {x["favorite_id"]: Favorite(**x) for x in data.get("favorites", [])}


def create_demo_cinema() -> OnlineCinema:
    cinema = OnlineCinema()

    cinema.add_genre(Genre(1, "Фантастика"))
    cinema.add_genre(Genre(2, "Драма"))
    cinema.add_genre(Genre(3, "Комедия"))

    cinema.directors[1] = Director(1, "Кристофер Нолан")
    cinema.actors[1] = Actor(1, "Мэттью Макконахи", "Купер")
    cinema.actors[2] = Actor(2, "Энн Хэтэуэй", "Брэнд")

    cinema.catalog.add(Movie(
        1,
        "Интерстеллар",
        2014,
        169,
        "12+",
        1,
        [1, 2],
        [1, 2],
        "Фантастическая история о космической экспедиции."
    ))

    cinema.add_subscription(Subscription(1, "Стандарт", 299.0, 30))
    cinema.add_subscription(Subscription(2, "Премиум", 599.0, 30))

    cinema.add_user(User(1, "Александр", "alex@example.com", "12345", 2))

    cinema.profiles[1] = Profile(1, 1, "Alex", [1, 2])
    cinema.reviews[1] = Review(
        1, 1, 1, 10, "Отличный фильм!", datetime.now().isoformat()
    )
    cinema.history[1] = WatchHistory(
        1, 1, 1, datetime.now().isoformat(), 75
    )
    cinema.favorites[1] = Favorite(
